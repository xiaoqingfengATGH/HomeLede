/dts-v1/;
#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7583.dtsi"
#include "an758x-nokia_xg-040g-common.dtsi"
#include "an758x-nokia_xg-040g-ubi-parts.dtsi"

/ {
	model = "Nokia XG-040G-MF (UBI)";
	compatible = "nokia,xg-040g-mf-ubi", "airoha,an7583", "airoha,en7583";

	aliases {
		/* Expose optical calibration through a stable NVMEM node. */
		pon-calibration = &pon_calibration_storage;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7583_pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_pon_registration: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&an7583_pinctrl 6 GPIO_ACTIVE_LOW>;
			/* Registration maps O1-O3 to fast blink, O4 to slow blink, and O5 on. */
			linux,default-trigger = "pon0-registration";
		};

		led_internet: led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&an7583_pinctrl 7 GPIO_ACTIVE_LOW>;
			/* pon0 service-ready state drives the Internet LED. */
			linux,default-trigger = "pon0-online";
		};

		led_power_green: led-2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&an7583_pinctrl 25 GPIO_ACTIVE_LOW>;
			panic-indicator;
		};

		led-3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <1>;
			gpios = <&an7583_pinctrl 26 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port1>;
		};

		led_pon_los: led-4 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&an7583_pinctrl 27 GPIO_ACTIVE_LOW>;
			/* The LOS LED follows optical signal loss. */
			linux,default-trigger = "pon0-los";
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <2>;
			gpios = <&an7583_pinctrl 33 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port2>;
		};
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "fixed-3.3V";
	};

	reg_usb_5v: regulator-usb-5v {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&an7583_pinctrl 30 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "usb-5v";
	};

	/*
	 * Controls both USB ports at once
	 */
	usb-power {
		compatible = "regulator-output";
		vout-supply = <&reg_usb_5v>;
	};
};

&an7583_pinctrl {
	gpio-ranges = <&an7583_pinctrl 0 2 53>;

	/*
	 * MF uses the primary AN7583 PON pinout with GPIO15 as TX_DISABLE.
	 * The optical frontend owns GPIO15 while pinctrl owns the other signals.
	 */
	pon_pins: pon-pins {
		mux {
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio0_pins: mdio0-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
		conf {
			pins = "mdio_0";
			output-high;
		};
	};

	/*
	 * AN7583 multiplexes I2C0 SCL and SDA with GPIO. Selecting this pin group
	 * routes the dedicated I2C0 pins to optical frontend windows 0x50 and 0x51.
	 */
	i2c0_pins: i2c0-pins {
		mux {
			function = "i2c";
			groups = "i2c0";
		};
	};

	spi_pins: spi-pins {
		mux {
			function = "spi";
			groups = "spi";
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	gswp1_led0_pins: gswp1-led0-pins {
		mux {
			function = "phy1_led0";
			pins = "gpio1";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio2";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio3";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio4";
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;

	/*
	 * Window 0x50 loads MD32 and 0x51 provides runtime access.
	 * GPIO15 high disables optical transmission.
	 */
	en7572: optical-front-end@50 {
		compatible = "airoha,en7572";
		reg = <0x50>;

		/* Logical high keeps optical transmission disabled during probe. */
		tx-disable-gpios = <&an7583_pinctrl 15 GPIO_ACTIVE_HIGH>;

		/* The 512 bytes after the bosa header contain per-device optical data. */
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
	};
};

&snfi {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins>;
};

&mdio_0 {
	/* Airoha EN8811 2.5Gbps phy */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;

		reset-gpios = <&an7583_pinctrl 34 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <20000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led-0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
};

&gsw_port2 {
	status = "okay";

	label = "lan2";
};

&gsw_phy2 {
	status = "okay";

	interrupts = <2>;

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
};

&gsw_phy2_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&gsw_port3 {
	status = "okay";

	label = "lan3";
};

&gsw_phy3 {
	status = "okay";

	interrupts = <3>;

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
};

&gsw_phy3_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&gsw_port4 {
	status = "okay";

	label = "lan4";
};

&gsw_phy4 {
	status = "okay";

	interrupts = <4>;

	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
};

&gsw_phy4_led0 {
	status = "okay";

	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&gdm3 {
	status = "okay";

	openwrt,netdev-name = "lan1";

	phy-handle = <&en8811>;
	phy-mode = "2500base-x";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_factory_3e (0)>;
};

&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";

	vusb33-supply = <&reg_3p3v>;

	#address-cells = <1>;
	#size-cells = <0>;

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};

	usb_port2: port@2 {
		reg = <2>;
		#trigger-source-cells = <0>;
	};
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&en7572>;
	nvmem-cells = <&pon_serial>;
	nvmem-cell-names = "pon-serial";
	/* data-path references the GDM carrying service GEM traffic. */
	data-path = <&gdm2>;
	status = "okay";
};

&gdm2 {
	/* GDM2 carries the PON GEM data plane on AN7581 and AN7583. */
	airoha,pon-data-path;
	/* WAN uses the eth0 MAC stored at RI offset 0x3e. */
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_factory_3e 0>;
	status = "okay";
};

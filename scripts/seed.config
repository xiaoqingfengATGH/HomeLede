# HomeLede build seed -- feeds `make defconfig` (the retired top-level
# defconfig file is replaced by native mechanisms):
#
#   software selection (=y packages)  -> target/linux/x86/Makefile DEFAULT_PACKAGES
#                                        include/target.mk DEFAULT_PACKAGES.router
#   image layout & formats            -> kept here (kconfig, no saner default home)
#   LuCI language                     -> CONFIG_LUCI_LANG_zh_Hans (pulls all zh-cn i18n)
#   kernel gates off generic defaults -> # not set lines below
#   package sub-options & flavors     -> dnsmasq_full_*, *_INCLUDE_*, mbedtls/nginx/
#                                        sing-box/openssl/boost build flavors
#   =m packages                       -> built as ipk artifacts only, not in image
#
# Regenerate after a deliberate config change with: ./scripts/diffconfig.sh
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_NOXML=y
CONFIG_ARIA2_OPENSSL=y
CONFIG_ARIA2_WEBSOCKET=y
CONFIG_GNUTLS_ALPN=y
CONFIG_GNUTLS_ANON=y
CONFIG_GNUTLS_DTLS_SRTP=y
CONFIG_GNUTLS_HEARTBEAT=y
CONFIG_GNUTLS_OCSP=y
CONFIG_GNUTLS_PSK=y
CONFIG_GRUB_TITLE="Homelede"
CONFIG_HTOP_LMSENSORS=y
# CONFIG_KERNEL_BPF_EVENTS is not set
# CONFIG_KERNEL_BTRFS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_CIFS_ACL is not set
CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
# CONFIG_KERNEL_EROFS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_F2FS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_F2FS_FS_SECURITY is not set
# CONFIG_KERNEL_FTRACE is not set
# CONFIG_KERNEL_HFSPLUS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_HFS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_JFFS2_FS_POSIX_ACL is not set
# CONFIG_KERNEL_JFFS2_FS_SECURITY is not set
# CONFIG_KERNEL_JFS_POSIX_ACL is not set
# CONFIG_KERNEL_KPROBES is not set
# CONFIG_KERNEL_NET_L3_MASTER_DEV is not set
# CONFIG_KERNEL_NFS_ACL_SUPPORT is not set
# CONFIG_KERNEL_REISER_FS_POSIX_ACL is not set
# CONFIG_KERNEL_TMPFS_POSIX_ACL is not set
# CONFIG_KERNEL_UBIFS_FS_SECURITY is not set
# CONFIG_KERNEL_XDP_SOCKETS is not set
# CONFIG_KERNEL_XFS_POSIX_ACL is not set
CONFIG_LIBSODIUM_MINIMAL=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_MBEDTLS_AES_C=y

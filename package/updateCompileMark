#!/bin/bash
SOURCE="$0"
while [ -h "$SOURCE"  ]; do
    DIR="$( cd -P "$( dirname "$SOURCE"  )" && pwd  )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /*  ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE"  )" && pwd  )"

# Release date of this HomeLede build (YYYY.MM.DD). Override to re-stamp an
# already-released version without bumping the date, e.g.:
#   COMPILE_DATE=2026.10.01 ./package/updateCompileMark
COMPILE_DATE="${COMPILE_DATE:-$(date +%Y.%m.%d)}"
COMPILE_MARK=v$COMPILE_DATE
echo $COMPILE_MARK > $DIR/base-files/files/etc/buildmark
echo Compile mark set to $COMPILE_MARK

# The OpenWrt base version stays as the %V placeholder: base-files expands it
# at package install time (include/version.mk VERSION_SED_SCRIPT) from the
# same VERSION_NUMBER that lands in /etc/openwrt_release DISTRIB_RELEASE, so
# banner and openwrt_release can never disagree.
# (lean used to keep an R-version literal here; upstream 4947846ea replaced it
# with a build-date placeholder expanded inside the default-settings package -
# which this tree retires - so the R-version is no longer a version number.)
sed -i "s/^.*%D.*$/ HomeLede $COMPILE_MARK based on %D %V/g" $DIR/base-files/files/etc/banner
echo Banner updated to
cat $DIR/base-files/files/etc/banner
